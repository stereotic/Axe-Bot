BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321

# GROOMING community bot (run with: npm run grooming)
GROOMING_BOT_TOKEN=
GROOMING_CHAT_ID=-1004330111419
# Optional separate cash channel; if empty, profits are posted once to GROOMING_CHAT_ID.
GROOMING_CASH_CHAT_ID=
# 7032488691 is always allowed; add the owner's Telegram ID here.
GROOMING_ADMIN_IDS=
GROOMING_BOT_USERNAME=AXE_GROOMING_xBot
# Опционально, если api.telegram.org недоступен (локальная разработка в РФ): http://127.0.0.1:7890
# TELEGRAM_PROXY=

# Battle Pass mini app
BATTLEPASS_URL=https://axe.crystalcards.store
BATTLEPASS_HOST=127.0.0.1
BATTLEPASS_PORT=8081
BATTLEPASS_DEV=0
# BATTLEPASS_DEV=1 разрешает ?user_id= без подписи Telegram. Использовать только локально.

# EpicBet profits: кому слать подтверждённые профиты из https://epicbet.space/eng/deposits/api_latest_profits (через запятую)
